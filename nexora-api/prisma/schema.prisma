  ruc       String?
  address   String?
  phone     String?
  createdAt DateTime @default(now())

  branches   Branch[]
  users      User[]
  suppliers  Supplier[]
  customers  Customer[]
  categories ItemCategory[]
  itemGroups ItemGroup[]
  itemBrands ItemBrand[]
  itemOwners ItemOwner[]
  items      Item[]
  sales      Sale[]
  purchases  Purchase[]
  returns    SaleReturn[]
  movements  InventoryMovement[]
  inventoryAdjustments InventoryAdjustment[]
  paymentMethods PaymentMethod[]
  taxes      Tax[]
}

model Branch {
  id        Int      @id @default(autoincrement())
  name      String
  address   String?
  phone     String?
  logoUrl   String?
  createdAt DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id])
  companyId Int

  userBranches UserBranch[]
  stocks       BranchStock[]
  sales        Sale[]
  purchases    Purchase[]
  returns      SaleReturn[]
  movements    InventoryMovement[]
  inventoryAdjustments InventoryAdjustment[]
}

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique

  users User[]
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id])
  companyId Int

  role   Role @relation(fields: [roleId], references: [id])
  roleId Int

  userBranches UserBranch[]
  sales        Sale[]
  purchases    Purchase[]
  returns      SaleReturn[]
  movements    InventoryMovement[]
  requestedAdjustments InventoryAdjustment[] @relation("InventoryAdjustmentRequestedBy")
  approvedAdjustments  InventoryAdjustment[] @relation("InventoryAdjustmentApprovedBy")
}

model UserBranch {
  userId     Int
  branchId   Int
  isActive   Boolean  @default(true)
  assignedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@id([userId, branchId])
  @@index([branchId])
}

enum ItemType {
  MUEBLE
  INSUMO
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  ruc       String?
  phone     String?
  email     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id])
  companyId Int

  items     Item[]
  purchases Purchase[]

  @@index([companyId])
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  document  String?
  phone     String?
  email     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id])
  companyId Int

  sales   Sale[]
  returns SaleReturn[]

  @@index([companyId])
}

model ItemCategory {
  id        Int      @id @default(autoincrement())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id])
  companyId Int

  items Item[]

  @@unique([companyId, name])
  @@index([companyId])
}

model ItemGroup {
  id        Int      @id @default(autoincrement())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id])
  companyId Int

  items Item[]

  @@unique([companyId, name])
  @@index([companyId])
}

model ItemBrand {
  id        Int      @id @default(autoincrement())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id])
  companyId Int

  items Item[]

  @@unique([companyId, name])
  @@index([companyId])
}

model ItemOwner {
  id        Int      @id @default(autoincrement())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id])
  companyId Int

  items Item[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Tax {
  id        Int      @id @default(autoincrement())
  name      String
  rate      Decimal  @db.Decimal(5, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id])
  companyId Int

  saleTaxes SaleTax[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Item {
  id                Int      @id @default(autoincrement())
  name              String
  sku               String?
  barcode           String?
  type              ItemType @default(MUEBLE)
  groupId           Int?
  brandId           Int?
  model             String?
  description       String?
  imageUrl          String?
  costPrice         Decimal? @db.Decimal(12, 2)
  basePrice         Decimal? @db.Decimal(12, 2)
  salePrice         Decimal? @db.Decimal(12, 2)
  wholesalePrice    Decimal? @db.Decimal(12, 2)
  discountPercent   Decimal? @db.Decimal(5, 2)
  promotionPercent  Decimal? @db.Decimal(5, 2)
  ownerId           Int?
  providerId        Int
  observations      String?
  trackStock        Boolean  @default(true)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id])
  companyId Int

  category   ItemCategory @relation(fields: [categoryId], references: [id])
  categoryId Int

  group  ItemGroup? @relation(fields: [groupId], references: [id])
  brand  ItemBrand? @relation(fields: [brandId], references: [id])
  owner  ItemOwner? @relation(fields: [ownerId], references: [id])
  supplier Supplier @relation(fields: [providerId], references: [id])

  stocks       BranchStock[]
  saleDetails    SaleDetail[]
  purchaseDetails PurchaseDetail[]
  returnDetails  SaleReturnDetail[]
  movements    InventoryMovement[]
  inventoryAdjustments InventoryAdjustment[]

  @@unique([companyId, sku])
  @@unique([companyId, barcode])
  @@index([companyId])
  @@index([categoryId])
  @@index([groupId])
  @@index([brandId])
  @@index([ownerId])
  @@index([providerId])
}

model BranchStock {
  id        Int      @id @default(autoincrement())
  branchId  Int
  itemId    Int
  quantity  Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])
  item   Item   @relation(fields: [itemId], references: [id])

  @@unique([branchId, itemId])
  @@index([itemId])
}

enum InventoryMovementType {
  INITIAL
  SALE
  RETURN_SALE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

model InventoryMovement {
  id            Int                   @id @default(autoincrement())
  companyId     Int
  branchId      Int
  itemId        Int
  createdById   Int?
  type          InventoryMovementType
  quantity      Decimal               @db.Decimal(14, 2)
  balanceAfter  Decimal               @db.Decimal(14, 2)
  reference     String?
  notes         String?
  createdAt     DateTime              @default(now())

  company   Company @relation(fields: [companyId], references: [id])
  branch    Branch  @relation(fields: [branchId], references: [id])
  item      Item    @relation(fields: [itemId], references: [id])
  createdBy User?   @relation(fields: [createdById], references: [id])

  @@index([companyId, createdAt])
  @@index([branchId, itemId, createdAt])
}

enum AdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

model InventoryAdjustment {
  id            Int              @id @default(autoincrement())
  companyId     Int
  branchId      Int
  itemId        Int
  requestedById Int
  approvedById  Int?
  quantity      Decimal          @db.Decimal(14, 2)
  reason        String?
  notes         String?
  status        AdjustmentStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  approvedAt    DateTime?

  company   Company @relation(fields: [companyId], references: [id])
  branch    Branch  @relation(fields: [branchId], references: [id])
  item       Item    @relation(fields: [itemId], references: [id])
  requestedBy User   @relation("InventoryAdjustmentRequestedBy", fields: [requestedById], references: [id])
  approvedBy  User?  @relation("InventoryAdjustmentApprovedBy", fields: [approvedById], references: [id])

  @@index([companyId, status])
  @@index([branchId, itemId])
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum SalePaymentStatus {
  PAID
  PARTIAL
  PENDING
  CANCELLED
}

model Sale {
  id                    Int                 @id @default(autoincrement())
  companyId             Int
  branchId              Int
  customerId            Int?
  sellerId              Int
  systemNumber          String
  externalReceiptNumber String?
  subtotal              Decimal             @default(0) @db.Decimal(12, 2)
  discount              Decimal             @default(0) @db.Decimal(12, 2)
  transport             Decimal             @default(0) @db.Decimal(12, 2)
  tax                   Decimal             @default(0) @db.Decimal(12, 2)
  total                 Decimal             @default(0) @db.Decimal(12, 2)
  notes                 String?
  isCredit              Boolean             @default(false)
  dueDate               DateTime?
  installments          Int                 @default(1)
  interestRate          Decimal             @default(0) @db.Decimal(5, 2)
  lateInterestRate      Decimal             @default(0) @db.Decimal(5, 2)
  interestAmount        Decimal             @default(0) @db.Decimal(12, 2)
  paidAmount            Decimal             @default(0) @db.Decimal(12, 2)
  outstanding           Decimal             @default(0) @db.Decimal(12, 2)
  paymentStatus         SalePaymentStatus   @default(PAID)
  status                SaleStatus          @default(COMPLETED)
  createdAt             DateTime            @default(now())

  company  Company  @relation(fields: [companyId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  seller   User     @relation(fields: [sellerId], references: [id])

  details SaleDetail[]
  returns SaleReturn[]
  payments SalePayment[]
  saleTaxes SaleTax[]
  amortization SaleInstallment[]

  @@unique([companyId, systemNumber])
  @@index([branchId, createdAt])
}

model SaleDetail {
  id        Int      @id @default(autoincrement())
  saleId    Int
  itemId    Int
  quantity  Decimal  @db.Decimal(14, 2)
  unitPrice Decimal  @db.Decimal(12, 2)
  subtotal  Decimal  @db.Decimal(12, 2)
  isGift    Boolean  @default(false)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id])

  returnDetails SaleReturnDetail[]

  @@index([saleId])
  @@index([itemId])
}

model SalePayment {
  id              Int      @id @default(autoincrement())
  saleId          Int
  paymentMethodId Int
  amount          Decimal  @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime @default(now())

  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  @@index([saleId])
  @@index([paymentMethodId])
}

model SaleTax {
  saleId    Int
  taxId     Int
  
  sale      Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  tax       Tax  @relation(fields: [taxId], references: [id])

  @@id([saleId, taxId])
}

model SaleInstallment {
  id          Int      @id @default(autoincrement())
  saleId      Int
  quotaNumber Int
  dueDate     DateTime
  amount      Decimal  @db.Decimal(12, 2)
  paidAmount  Decimal  @default(0) @db.Decimal(12, 2)
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@unique([saleId, quotaNumber])
  @@index([saleId])
}

model PaymentMethod {
  id        Int      @id @default(autoincrement())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id])
  companyId Int

  salesPayments SalePayment[]

  @@unique([companyId, name])
  @@index([companyId])
}

model SaleReturn {
  id           Int      @id @default(autoincrement())
  companyId    Int
  branchId     Int
  saleId       Int
  customerId   Int?
  createdById  Int
  systemNumber String
  notes        String?
  createdAt    DateTime @default(now())

  company   Company   @relation(fields: [companyId], references: [id])
  branch    Branch    @relation(fields: [branchId], references: [id])
  sale      Sale      @relation(fields: [saleId], references: [id])
  customer  Customer? @relation(fields: [customerId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])

  details SaleReturnDetail[]

  @@unique([companyId, systemNumber])
  @@index([branchId, createdAt])
}

model SaleReturnDetail {
  id           Int     @id @default(autoincrement())
  saleReturnId Int
  saleDetailId Int?
  itemId       Int
  quantity     Decimal @db.Decimal(14, 2)
  unitPrice    Decimal @db.Decimal(12, 2)
  subtotal     Decimal @db.Decimal(12, 2)
  reason       String?

  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  saleDetail SaleDetail? @relation(fields: [saleDetailId], references: [id])
  item       Item       @relation(fields: [itemId], references: [id])

  @@index([saleReturnId])
  @@index([itemId])
}

model Purchase {
  id                    Int                 @id @default(autoincrement())
  companyId             Int
  branchId              Int
  supplierId            Int
  createdById           Int
  systemNumber          String
  supplierInvoiceNumber String?
  subtotal              Decimal             @default(0) @db.Decimal(12, 2)
  total                 Decimal             @default(0) @db.Decimal(12, 2)
  notes                 String?
  createdAt             DateTime            @default(now())

  company   Company  @relation(fields: [companyId], references: [id])
  branch    Branch   @relation(fields: [branchId], references: [id])
  supplier  Supplier @relation(fields: [supplierId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  details PurchaseDetail[]

  @@unique([companyId, systemNumber])
  @@index([branchId, createdAt])
}

model PurchaseDetail {
  id         Int     @id @default(autoincrement())
  purchaseId Int
  itemId     Int
  quantity   Decimal @db.Decimal(14, 2)
  unitCost   Decimal @db.Decimal(12, 2)
  subtotal   Decimal @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id])

  @@index([purchaseId])
  @@index([itemId])
}
