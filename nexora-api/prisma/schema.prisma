generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  ruc       String?
  address   String?
  phone     String?
  createdAt DateTime @default(now())

  branches   Branch[]
  users      User[]
  suppliers  Supplier[]
  customers  Customer[]
  categories ItemCategory[]
  items      Item[]
  sales      Sale[]
  returns    SaleReturn[]
  movements  InventoryMovement[]
}

model Branch {
  id        Int      @id @default(autoincrement())
  name      String
  address   String?
  phone     String?
  createdAt DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id])
  companyId Int

  userBranches UserBranch[]
  stocks       BranchStock[]
  sales        Sale[]
  returns      SaleReturn[]
  movements    InventoryMovement[]
}

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique

  users User[]
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id])
  companyId Int

  role   Role @relation(fields: [roleId], references: [id])
  roleId Int

  userBranches UserBranch[]
  sales        Sale[]
  returns      SaleReturn[]
  movements    InventoryMovement[]
}

model UserBranch {
  userId     Int
  branchId   Int
  isActive   Boolean  @default(true)
  assignedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@id([userId, branchId])
  @@index([branchId])
}

enum ItemType {
  MUEBLE
  INSUMO
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  ruc       String?
  phone     String?
  email     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id])
  companyId Int

  @@index([companyId])
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  document  String?
  phone     String?
  email     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id])
  companyId Int

  sales   Sale[]
  returns SaleReturn[]

  @@index([companyId])
}

model ItemCategory {
  id        Int      @id @default(autoincrement())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id])
  companyId Int

  items Item[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Item {
  id          Int      @id @default(autoincrement())
  name        String
  sku         String?
  barcode     String?
  type        ItemType @default(MUEBLE)
  description String?
  basePrice   Decimal? @db.Decimal(12, 2)
  salePrice   Decimal? @db.Decimal(12, 2)
  costPrice   Decimal? @db.Decimal(12, 2)
  trackStock  Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id])
  companyId Int

  category   ItemCategory @relation(fields: [categoryId], references: [id])
  categoryId Int

  stocks       BranchStock[]
  saleDetails  SaleDetail[]
  returnDetails SaleReturnDetail[]
  movements    InventoryMovement[]

  @@unique([companyId, sku])
  @@unique([companyId, barcode])
  @@index([companyId])
  @@index([categoryId])
}

model BranchStock {
  id        Int      @id @default(autoincrement())
  branchId  Int
  itemId    Int
  quantity  Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])
  item   Item   @relation(fields: [itemId], references: [id])

  @@unique([branchId, itemId])
  @@index([itemId])
}

enum InventoryMovementType {
  INITIAL
  SALE
  RETURN_SALE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

model InventoryMovement {
  id            Int                   @id @default(autoincrement())
  companyId     Int
  branchId      Int
  itemId        Int
  createdById   Int?
  type          InventoryMovementType
  quantity      Decimal               @db.Decimal(14, 2)
  balanceAfter  Decimal               @db.Decimal(14, 2)
  reference     String?
  notes         String?
  createdAt     DateTime              @default(now())

  company   Company @relation(fields: [companyId], references: [id])
  branch    Branch  @relation(fields: [branchId], references: [id])
  item      Item    @relation(fields: [itemId], references: [id])
  createdBy User?   @relation(fields: [createdById], references: [id])

  @@index([companyId, createdAt])
  @@index([branchId, itemId, createdAt])
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

model Sale {
  id                    Int        @id @default(autoincrement())
  companyId             Int
  branchId              Int
  customerId            Int?
  sellerId              Int
  systemNumber          String
  externalReceiptNumber String?
  subtotal              Decimal    @default(0) @db.Decimal(12, 2)
  total                 Decimal    @default(0) @db.Decimal(12, 2)
  notes                 String?
  status                SaleStatus @default(COMPLETED)
  createdAt             DateTime   @default(now())

  company  Company  @relation(fields: [companyId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  seller   User     @relation(fields: [sellerId], references: [id])

  details SaleDetail[]
  returns SaleReturn[]

  @@unique([companyId, systemNumber])
  @@index([branchId, createdAt])
}

